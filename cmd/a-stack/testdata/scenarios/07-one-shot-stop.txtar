as WORKER task status --task $TASK --progress working --expected-revision 2 --operation-id scenario-working
as WORKER hook enroll --claude --native-session enrolled-claude
event claude Stop $PROJECT enrolled-claude
stdin $WORK/event.json
hook
stdout '"decision":"block"'
stdin $WORK/event.json
hook
! stdout .
