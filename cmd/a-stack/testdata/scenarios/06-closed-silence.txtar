as WORKER task status --task $TASK --progress working --expected-revision 2 --operation-id scenario-working
as WORKER mail send --task $TASK --body retained --operation-id scenario-send
as WORKER hook enroll --claude --native-session native-closed
event claude SessionStart $PROJECT native-closed
stdin $WORK/event.json
hook
stdout 'you are the Agent worker'
as OPERATOR session close --expected-revision 2 --operation-id scenario-close
event claude SessionStart $PROJECT native-closed
stdin $WORK/event.json
hook
! stdout .
event codex Stop $PROJECT native-closed
stdin $WORK/event.json
hook
! stdout .
event pi SessionStart $PROJECT native-closed
stdin $WORK/event.json
hook
! stdout .
event opencode Stop $PROJECT native-closed
stdin $WORK/event.json
hook
! stdout .
as WORKER mail read --task $TASK
stdout retained
